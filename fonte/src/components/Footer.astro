---
import type { SiteContent } from '@/data/site'

interface Props {
  footer: SiteContent['footer']
}

const { footer } = Astro.props
---

<footer class="border-t border-ink/5 dark:border-paper/10">
  <div
    class="container-prose py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono text-ink/50 dark:text-paper/50"
  >
    <p>{footer.rights}</p>
    <p>saracgpereira.com</p>
  </div>
</footer>
