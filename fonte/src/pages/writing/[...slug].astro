---
import { getCollection, type CollectionEntry } from 'astro:content'
import Writing from '@/layouts/Writing.astro'

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

interface Props {
  post: CollectionEntry<'writing'>
}

const { post } = Astro.props
const { Content } = await post.render()
const publicado = post.data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<Writing
  title={`${post.data.title} — Sara Pereira`}
  description={post.data.description}
  canonical={`https://saracgpereira.com/writing/${post.slug}/`}
>
  <article>
    <header class="border-b border-ink/5 dark:border-paper/10">
      <div class="container-prose pt-24 pb-14 md:pt-32 md:pb-16">
        <p class="section-eyebrow mb-6">
          <a href="/writing/" class="link-underline">Writing</a>
        </p>
        <h1 class="font-serif text-4xl md:text-5xl leading-[1.08] tracking-tight max-w-3xl">
          {post.data.title}
        </h1>
        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs uppercase tracking-[0.15em] text-ink/50 dark:text-paper/50">
          <time datetime={post.data.pubDate.toISOString()}>{publicado}</time>
          {post.data.tags.map((tag) => <span>&middot; {tag}</span>)}
        </div>
      </div>
    </header>

    <div class="container-prose py-14 md:py-20">
      <div class="prose-note">
        <Content />
      </div>
    </div>

    <div class="container-prose pb-24">
      <p class="border-t border-ink/10 dark:border-paper/10 pt-8 font-mono text-xs uppercase tracking-[0.18em] text-ink/50 dark:text-paper/50">
        <a href="/writing/" class="link-underline hover:text-accent">All writing</a>
      </p>
    </div>
  </article>
</Writing>
